/-! # Website build configuration

The renderers require the actual build's admitted Lake dependency selection.
The cold configuration and compiler consumer include one selector refusal.
-/

public section

namespace RendererSelection
run_cmd do
  let input := Lean.Parser.mkInputContext (include_str "../lean/Regula/LakeBuildConfig.inc")
    "Regula/LakeBuildConfig.inc"
  let result ← Lean.Elab.IO.processCommands input {} (← get)
  set result.commandState
run_cmd do
  let input := Lean.Parser.mkInputContext (include_str "../lean/Regula/RendererSelection.inc")
    "Regula/RendererSelection.inc"
  let result ← Lean.Elab.IO.processCommands input {} (← get)
  set result.commandState
end RendererSelection

package regula_website where
  packagesDir := "../.lake/packages"

require verso from git "https://github.com/leanprover/verso" @
  "cad4b633e75ea769b851f12f9ca3b4f0dfcc625f"
require regula from ".."
require regula_audit from "../audit"

/-- Admit the current build's resolved workspace every time, including cached builds.
The generated record is a trusted build input. No success from an earlier invocation is reused. -/
target rendererSelection pkg : System.FilePath := do
  let workspace ← getWorkspace
  let selection ← RendererSelection.admitBuild (← RendererSelection.buildConfig workspace) workspace
  let file := RendererSelection.selectionFile pkg.dir
  IO.FS.createDirAll file.parent.get!
  let text := (Lean.toJson selection).compress
  IO.FS.writeFile file text
  return Job.ofTask <| Task.pure <| .ok file {
    trace := .ofHash (pureHash text) "admitted renderer selection" }

-- Site-owned Verso extensions and styles.
lean_lib RegulaSite

-- Generated by the root site executable; never edited by hand.
lean_lib Generated where
  globs := #[.andSubmodules `Generated]

@[default_target]
lean_exe «regula-site» where
  root := `Main
  needs := #[`@/rendererSelection]

lean_lib RegulaExample

-- Verso elaborates each example where it is written, using the built helper and imports.
lean_lib RegulaStandard where
  globs := #[.andSubmodules `RegulaStandard]
  needs := #[`@/«regula-example», `@regula_audit/Audit, `@regula/AuditApp]

lean_exe «regula-example» where
  root := `RegulaExampleMain
  supportInterpreter := true

lean_exe «regula-standard» where
  root := `StandardMain
  needs := #[`@/rendererSelection]
